{
	frankenphp
	auto_https off
	admin 127.0.0.1:2019

	servers :80 {
		protocols h1
	}
}

https://dev.cardascia-it.org:443 {
	tls {$LUMINA_CERT_FILE} {$LUMINA_KEY_FILE}

	root * public/
	encode zstd br gzip

	# Serve Vite build assets directly (no PHP)
	@assets path /build/*
	file_server @assets

	# Everything else goes through the Laravel worker
	php_server {
		worker {
			file public/frankenphp-worker.php
			num 4

			# Restart the workers when the code changes: they keep the application booted between
			# requests. The same list as `watch` in config/octane.php, which `octane:start --watch`
			# reads — DevServerWatchParityTest fails when they differ. Never a bare `watch`: its
			# default pattern covers storage/framework/views, rewritten by Blade on every compile.
			watch app
			watch bootstrap
			watch config/**/*.php
			watch database/**/*.php
			watch public/**/*.php
			watch resources/**/*.php
			watch routes
			watch composer.lock
			watch .env
		}
	}
}

# HTTP → HTTPS redirect
http://dev.cardascia-it.org:80 {
	redir https://{host}{uri} permanent
}
