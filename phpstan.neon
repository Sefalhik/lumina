includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    level: 8
    paths:
        - app
    excludePaths:
        - app/Providers
    stubFiles:
        - phpstan-stubs.php
    parallel:
        maximumNumberOfProcesses: 1
