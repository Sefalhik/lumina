includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/tomasvotruba/cognitive-complexity/config/extension.neon

parameters:
    level: 8
    paths:
        - app
    excludePaths:
        - app/Providers
    stubFiles:
        - phpstan-stubs.php
    parallel:
        maximumNumberOfProcesses: 1

    # Cognitive complexity (LUMN-62): how hard a method, and a class, are to follow — nesting and
    # breaks in the flow count, comments and blank lines do not. Measured on app/ on 2026-11-14:
    # 14 for the most complex method and 37 for the most complex class, I18nTranslate aside — its
    # exception went with its rewrite, LUMN-110 (2026-11-15: 14 and 34). Each threshold sits just
    # above: a ratchet, not a figure from an article. The measure and the reasoning are in
    # docs/quality-tooling.md.
    cognitive_complexity:
        function: 15
        class: 40

