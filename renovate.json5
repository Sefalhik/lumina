{
    $schema: "https://docs.renovatebot.com/renovate-schema.json",
    extends: ["config:best-practices", ":separateMultipleMajorReleases"],
    ignorePresets: [":pinDevDependencies"],
    timezone: "Europe/Paris",
    schedule: ["* * * * 1"],
    lockFileMaintenance: {
        schedule: ["* * * * 1"],
    },
    prConcurrentLimit: 3,
    prHourlyLimit: 2,
    minimumReleaseAgeBehaviour: "timestamp-required",
    internalChecksFilter: "strict",
    skipInstalls: false,
    npmrc: "# Renovate ignores the repository .npmrc on purpose: see renovate.json5",
    packageRules: [
        {
            description: "npm routine updates: one grouped PR per week.",
            matchManagers: ["npm"],
            matchUpdateTypes: ["minor", "patch"],
            groupName: "npm (minor and patch)",
        },
        {
            description: "Composer routine updates: one grouped PR per week.",
            matchManagers: ["composer"],
            matchUpdateTypes: ["minor", "patch"],
            groupName: "composer (minor and patch)",
        },
        {
            description: "npm and GitHub Actions releases wait 3 days before being proposed.",
            matchDatasources: ["npm", "github-tags"],
            minimumReleaseAge: "3 days",
        },
        {
            description: "Majors call for a decision: held until approved from the Dependency Dashboard.",
            matchUpdateTypes: ["major"],
            dependencyDashboardApproval: true,
        },
        {
            description: "GitHub Actions: one grouped PR for every update, majors included, without approval.",
            matchManagers: ["github-actions"],
            matchDepTypes: ["action"],
            groupName: "github actions",
            dependencyDashboardApproval: false,
            separateMajorMinor: false,
            separateMultipleMajor: false,
        },
        {
            description: "PostgreSQL majors in CI are coordinated changes, never a Renovate PR.",
            matchManagers: ["github-actions"],
            matchDepNames: ["postgres"],
            matchUpdateTypes: ["major"],
            enabled: false,
        },
        {
            description: "Node majors: on the Dependency Dashboard once they are LTS, held for approval.",
            matchManagers: ["nvm"],
            matchDepNames: ["node"],
            matchUpdateTypes: ["major"],
            dependencyDashboardApproval: true,
        },
        {
            description: "The PHP runtime constraint is never a Renovate PR.",
            matchManagers: ["composer"],
            matchDepNames: ["php"],
            enabled: false,
        },
    ],
    vulnerabilityAlerts: {
        labels: ["security"],
        schedule: ["at any time"],
    },
    dependencyDashboard: {
        osvVulnerabilitySummary: "all",
    },
}
